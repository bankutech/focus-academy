rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasEmail(emails) {
      return isAuthenticated()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in emails;
    }

    function hasRole(roles) {
      return isAuthenticated() && request.auth.token.role in roles;
    }

    // Only institute owners may change roles, settings ownership or restore backups.
    function isOwner() {
      return isOwnerEmail() || hasRole(['owner']);
    }

    function isOwnerEmail() {
      return hasEmail([
        'director@focusacademyperambalur.com',
        'focusacademy.perambalur@gmail.com',
        'sagnikmitra1302@gmail.com'
      ]);
    }

    function isAdministrator() {
      return isOwner()
        || hasRole(['admin', 'administrator'])
        || (isAuthenticated() && request.auth.token.admin == true)
        || hasEmail([
          'admin@focusacademyperambalur.com',
          'principal@focusacademyperambalur.com'
        ]);
    }

    function isAdmin() {
      return isAdministrator();
    }

    // Admissions staff may work on inquiries, admissions and student profiles,
    // but must not record payments, apply waivers or alter academy settings.
    function isAdmissions() {
      return isAdministrator()
        || hasRole(['admissions'])
        || hasEmail(['admissions@focusacademyperambalur.com']);
    }

    function isFeeManager() {
      return isAdministrator()
        || hasRole(['fee_manager'])
        || hasEmail(['coordinator@focusacademyperambalur.com']);
    }

    function isTeachingStaff() {
      return isFeeManager()
        || isAdmissions()
        || hasRole(['teacher', 'read_only', 'viewer']);
    }

    match /batches/{batchId} {
      allow read: if true;
      allow write: if isAdministrator();
    }

    match /students/{studentId} {
      allow read: if isTeachingStaff() || (
        isAuthenticated() && (
          resource.data.studentUid == request.auth.uid ||
          (request.auth.token.email != null && resource.data.email == request.auth.token.email)
        )
      );
      // Financial and lifecycle history must never be hard-deleted from the client.
      allow create, update: if isAdmissions();
      allow delete: if false;
    }

    match /fee_obligations/{obligationId} {
      allow read: if isFeeManager() || (
        isAuthenticated() && (
          resource.data.studentUid == request.auth.uid ||
          (request.auth.token.email != null && resource.data.email == request.auth.token.email)
        )
      );
      allow write: if isFeeManager();
    }

    match /payments/{paymentId} {
      allow read: if isFeeManager() || (
        isAuthenticated() && (
          resource.data.studentUid == request.auth.uid ||
          (request.auth.token.email != null && resource.data.email == request.auth.token.email)
        )
      );
      allow create: if isFeeManager()
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.keys().hasAll(['id', 'receiptNumber', 'obligationId', 'studentId', 'amount', 'recordedBy'])
        && request.resource.data.recordedBy == request.auth.token.email.lower();
      allow update: if isFeeManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['isReversed', 'reversed', 'reversalReason', 'reversedBy', 'reversedAt', 'status', 'refundStatus']
        );
      allow delete: if false;
    }

    match /collection_reconciliations/{reconciliationId} {
      allow read, update: if isFeeManager();
      allow create: if isFeeManager()
        && request.resource.data.reconciledBy == request.auth.token.email.lower();
      allow delete: if false;
    }

    match /reminders/{reminderId} {
      allow read, write: if isFeeManager();
    }

    match /audit_logs/{logId} {
      allow read: if isAdministrator();
      // Students must never be able to forge or erase an audit entry.
      allow create: if (isFeeManager() || isAdmissions())
        && request.resource.data.actor == request.auth.token.email.lower();
      allow update, delete: if false;
    }

    match /leads/{leadId} {
      allow read, update, delete: if isAdmissions();
      allow create: if isAdmissions() || (
        request.resource.data.keys().hasAll(['studentName', 'phone', 'grade'])
        && request.resource.data.studentName is string && request.resource.data.studentName.size() >= 2
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 10
      );
    }

    match /reservations/{reservationId} {
      allow read: if true;
      allow create, update: if isAdministrator() || (
        request.resource.data.keys().hasAll(['batchId', 'studentName', 'phone'])
        && request.resource.data.studentName is string
        && request.resource.data.phone is string
      );
      allow delete: if isAdministrator();
    }

    match /counters/{counterId} {
      allow read, create, update: if isFeeManager();
      allow delete: if false;
    }

    match /payment_refs/{refId} {
      allow read, create, delete: if isFeeManager();
      allow update: if false;
    }

    match /till_sessions/{sessionId} {
      allow read, create, update: if isFeeManager();
      allow delete: if false;
    }

    match /academy_settings/{settingId} {
      allow read: if isAdministrator();
      allow create, delete: if isOwner();
      allow update: if isAdministrator() && (
        isOwner()
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authorizedAdmins'])
      );
    }

    match /student_profiles/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdministrator());
      allow create: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdministrator())
        && (!('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid)
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || isAdministrator());
      allow delete: if isAdministrator();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAdmissions() || isFeeManager() || (
        isAuthenticated() && (
          resource.data.studentUid == request.auth.uid ||
          (request.auth.token.email != null && resource.data.email == request.auth.token.email)
        )
      );
      allow create: if isAdmissions() || (
        request.resource.data.keys().hasAll(['id', 'studentName', 'phone', 'grade', 'board', 'batchId'])
        && request.resource.data.studentName is string && request.resource.data.studentName.size() >= 2
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 10
      );
      allow update, delete: if isAdmissions();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
