rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isStaffEmail() {
      return isAuthenticated() && request.auth.token.email != null && request.auth.token.email.lower() in [
        'admin@focusacademyperambalur.com',
        'director@focusacademyperambalur.com',
        'principal@focusacademyperambalur.com',
        'coordinator@focusacademyperambalur.com',
        'focusacademy.perambalur@gmail.com',
        'sagnikmitra1302@gmail.com'
      ];
    }

    function isOwner() {
      return isAuthenticated() && (
        request.auth.token.role == 'owner' ||
        isStaffEmail()
      );
    }

    function isAdministrator() {
      return isOwner() || (
        isAuthenticated() && (
          request.auth.token.admin == true ||
          request.auth.token.role in ['admin', 'administrator'] ||
          isStaffEmail()
        )
      );
    }

    function isFeeManager() {
      return isAdministrator() || (
        isAuthenticated() && (
          request.auth.token.role == 'fee_manager' ||
          isStaffEmail()
        )
      );
    }

    function isAdmin() {
      return isFeeManager();
    }

    match /batches/{batchId} {
      allow read: if true;
      allow write: if isAdministrator();
    }

    match /students/{studentId} {
      allow read, create, update, delete: if isAdministrator();
    }

    match /fee_obligations/{obligationId} {
      allow read, write: if isFeeManager();
    }

    match /payments/{paymentId} {
      allow read: if isFeeManager();
      allow create: if isFeeManager()
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.keys().hasAll(['id', 'receiptNumber', 'obligationId', 'studentId', 'amount', 'recordedBy']);
      allow update: if isFeeManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['isReversed', 'reversed', 'reversalReason', 'reversedBy', 'reversedAt', 'status', 'refundStatus']
        );
      allow delete: if false;
    }

    match /reminders/{reminderId} {
      allow read, write: if isFeeManager();
    }

    match /audit_logs/{logId} {
      allow read: if isAdministrator();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /leads/{leadId} {
      allow create: if false;
      allow read, update: if isAdministrator();
      allow delete: if false;
    }

    match /reservations/{reservationId} {
      allow create: if false;
      allow read, update: if isAdministrator();
      allow delete: if false;
    }

    match /counters/{counterId} {
      allow read: if isFeeManager();
      allow create: if isFeeManager() && request.resource.data.value == 1;
      allow update: if isFeeManager() && request.resource.data.value == resource.data.value + 1;
      allow delete: if false;
    }

    match /payment_refs/{refId} {
      allow read, create, delete: if isFeeManager();
      allow update: if false;
    }

    match /till_sessions/{sessionId} {
      allow read, create, update: if isFeeManager();
      allow delete: if false;
    }

    match /academy_settings/{settingId} {
      allow read: if isAdministrator();
      allow create, delete: if isOwner();
      allow update: if isAdministrator() && (
        isOwner()
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authorizedAdmins'])
      );
    }

    match /student_profiles/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdministrator());
      allow create: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdministrator())
        && (!('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid)
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || isAdministrator());
      allow delete: if isAdministrator();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (
        resource.data.studentUid == request.auth.uid ||
        (request.auth.token.email != null && resource.data.email == request.auth.token.email) ||
        isAdministrator()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.studentUid == request.auth.uid ||
        isAdministrator()
      );
      allow update: if isAdministrator();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
